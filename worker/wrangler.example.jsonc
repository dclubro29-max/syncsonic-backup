{
  "name": "syncsonic",
  "main": "index.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{
    "binding": "TRANSFER_KV",
    "id": "REPLACE_WITH_TARGET_TRANSFER_KV_NAMESPACE_ID"
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "syncsonic",
    "database_id": "REPLACE_WITH_TARGET_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
