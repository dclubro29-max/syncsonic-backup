{
  "name": "RemoteDevice",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Identitatea local\u0103 a dispozitivului care public\u0103 biblioteca."
    },
    "label": {
      "type": "string",
      "description": "Numele scurt afi\u0219at pe telefon (sistem de operare + cod)."
    },
    "tracks": {
      "type": "array",
      "description": "Piesele din biblioteca dispozitivului, doar id \u0219i nume.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "track_count": {
      "type": "number"
    },
    "updated_at": {
      "type": "number",
      "description": "Ultima semnalizare a dispozitivului, \u00een milisecunde."
    },
    "audio_ready": {
      "type": "boolean",
      "default": false
    },
    "now_playing": {
      "type": "object",
      "description": "Starea red\u0103rii publicat\u0103 de gazd\u0103, f\u0103r\u0103 a trimite fi\u0219iere audio.",
      "properties": {
        "track_id": {
          "type": "string"
        },
        "track_name": {
          "type": "string"
        },
        "cover": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "is_playing": {
          "type": "boolean"
        },
        "master_volume": {
          "type": "number"
        },
        "auto_dj": {
          "type": "boolean"
        },
        "party_max": {
          "type": "boolean"
        },
        "updated_at": {
          "type": "number"
        }
      }
    },
    "queue": {
      "type": "array",
      "description": "Coada manual\u0103 publicat\u0103 de gazd\u0103.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "device_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}