{
  "name": "PremiumEntitlement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "expires_on": {
      "type": "string",
      "format": "date"
    },
    "lifetime": {
      "type": "boolean",
      "default": false,
      "description": "Acces permanent, care nu poate fi retrogradat de un cod temporar."
    },
    "activation_count": {
      "type": "number",
      "default": 0
    },
    "last_activation_id": {
      "type": "string"
    },
    "last_code_masked": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "campaign_id",
    "expires_on"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}