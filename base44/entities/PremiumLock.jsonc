{
  "name": "PremiumLock",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}